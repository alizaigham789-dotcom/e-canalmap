{
  "name": "Form33CRecord",
  "type": "object",
  "properties": {
    "fasal": {
      "type": "string"
    },
    "year": {
      "type": "string"
    },
    "orientation": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "villages_json": {
      "type": "string",
      "description": "JSON string of village rows"
    },
    "signatures_json": {
      "type": "string",
      "description": "JSON string of signature metadata"
    }
  },
  "required": [
    "fasal",
    "year"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}