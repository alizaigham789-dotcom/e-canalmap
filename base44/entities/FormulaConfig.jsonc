{
  "name": "FormulaConfig",
  "type": "object",
  "properties": {
    "formula_key": {
      "type": "string",
      "description": "Unique key for this formula (e.g. water_time_per_acre)"
    },
    "label": {
      "type": "string",
      "description": "Human-readable label for the formula"
    },
    "unit_type": {
      "type": "string",
      "enum": [
        "water_time_per_acre",
        "water_time_per_kanal",
        "multiplier",
        "rounding"
      ],
      "description": "Category of the formula"
    },
    "value": {
      "type": "number",
      "description": "The formula value (e.g. 6 for minutes per acre)"
    },
    "description": {
      "type": "string",
      "description": "Optional description / notes for this formula (up to 1000 characters)",
      "maxLength": 1000
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this formula is active"
    }
  },
  "required": [
    "formula_key",
    "label",
    "value"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}