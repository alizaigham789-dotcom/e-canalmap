{
  "name": "ParatWarabandi",
  "type": "object",
  "properties": {
    "warabandi_type": {
      "type": "string",
      "enum": [
        "\u067e\u0631\u062a \u0648\u0627\u0631\u06c1 \u0628\u0646\u062f\u06cc",
        "\u062a\u0631\u0645\u06cc\u0645 \u0648\u0627\u0631\u06c1 \u0628\u0646\u062f\u06cc"
      ],
      "description": "Type of Warabandi"
    },
    "canal_name": {
      "type": "string",
      "description": "Canal Name"
    },
    "mogha_name": {
      "type": "string",
      "description": "\u0645\u0648\u06af\u06c1 \u0646\u0627\u0645"
    },
    "mogha_number": {
      "type": "string",
      "description": "\u0645\u0648\u06af\u06c1 \u0646\u0645\u0628\u0631\u06cc (numeric)"
    },
    "mogha_side": {
      "type": "string",
      "enum": [
        "L",
        "R"
      ],
      "description": "Mogha Side (L/R)"
    },
    "village_name": {
      "type": "string",
      "description": "Village Name"
    },
    "sub_division": {
      "type": "string",
      "description": "Sub Division"
    },
    "division": {
      "type": "string",
      "description": "Division"
    },
    "warabandi_date": {
      "type": "string",
      "format": "date",
      "description": "Warabandi Date"
    },
    "applicant_name": {
      "type": "string",
      "description": "Applicant Name"
    },
    "applicant_father": {
      "type": "string",
      "description": "Applicant Father Name"
    },
    "applicant_cnic": {
      "type": "string",
      "description": "Applicant CNIC"
    },
    "shareholders": {
      "type": "string",
      "description": "JSON string of shareholder rows"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "completed"
      ],
      "default": "draft"
    },
    "notes": {
      "type": "string"
    },
    "is_template": {
      "type": "boolean",
      "default": false,
      "description": "True for sample/demo warabandi parat shown to all users as motivation"
    }
  },
  "required": [
    "village_name"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.is_template": true
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.is_template": true
        }
      ]
    }
  }
}