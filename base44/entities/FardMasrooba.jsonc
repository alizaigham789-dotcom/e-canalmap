{
  "name": "FardMasrooba",
  "type": "object",
  "properties": {
    "mogha_number": {
      "type": "string",
      "description": "\u0645\u0648\u06af\u06c1 \u0646\u0645\u0628\u0631\u06cc"
    },
    "mogha_side": {
      "type": "string",
      "enum": [
        "L",
        "R",
        ""
      ],
      "description": "Mogha Side L/R"
    },
    "rajbah": {
      "type": "string",
      "description": "\u0631\u0627\u062c\u0628\u0627\u06c1 / Canal minor name"
    },
    "village": {
      "type": "string",
      "description": "\u0645\u0648\u0636\u0639 1 (first mouza name)"
    },
    "village2": {
      "type": "string",
      "description": "\u0645\u0648\u0636\u0639 2 (second mouza name, shown as \u0645\u0648\u0636\u0639 X \u0648 Y)"
    },
    "section": {
      "type": "string",
      "description": "\u0636\u0644\u0639\u062f\u0627\u0631\u06cc \u0633\u06cc\u06a9\u0634\u0646"
    },
    "tehsil": {
      "type": "string",
      "description": "\u0633\u0628 \u0688\u0648\u06cc\u0698\u0646"
    },
    "district": {
      "type": "string",
      "description": "\u06a9\u06cc\u0646\u0627\u0644 \u0688\u0648\u06cc\u0698\u0646"
    },
    "map_id": {
      "type": "string",
      "description": "Reference to the LandMap id (for khasra/bandubast picker)"
    },
    "rows_json": {
      "type": "string",
      "description": "JSON string of farmer rows (name, khasra, area, crop, abiana, phone, mozah)"
    },
    "rate_config_json": {
      "type": "string",
      "description": "JSON string of abiana rate config (mode: manual/fix/fasal, fix rates, crop-wise rates)"
    },
    "total_abiana": {
      "type": "number",
      "default": 0,
      "description": "Total Abiana amount"
    },
    "total_area": {
      "type": "number",
      "default": 0,
      "description": "Total area (kanal)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "completed"
      ],
      "default": "draft"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "mogha_number"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}