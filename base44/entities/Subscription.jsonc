{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User id this subscription belongs to"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "description": "Amount paid in PKR"
    },
    "method": {
      "type": "string",
      "enum": [
        "stripe",
        "manual",
        "referral"
      ],
      "description": "Payment method"
    },
    "plan_code": {
      "type": "string",
      "enum": [
        "2m",
        "6m",
        "y"
      ],
      "description": "Subscription plan (2-month / 6-month / yearly)"
    },
    "is_referral_reward": {
      "type": "boolean",
      "default": false,
      "description": "True if this is a free referral-reward subscription"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "expired",
        "rejected"
      ],
      "default": "pending",
      "description": "Subscription status"
    },
    "payment_date": {
      "type": "string",
      "format": "date-time",
      "description": "When payment was confirmed"
    },
    "expiry_date": {
      "type": "string",
      "format": "date-time",
      "description": "Access expiry"
    },
    "receipt_url": {
      "type": "string",
      "description": "Uploaded receipt/slip URL (manual method)"
    },
    "stripe_session_id": {
      "type": "string",
      "description": "Stripe Checkout Session id (stripe method)"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "method"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}