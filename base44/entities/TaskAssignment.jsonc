{
  "name": "TaskAssignment",
  "type": "object",
  "properties": {
    "division": {
      "type": "string",
      "description": "Canal Division"
    },
    "subdivision": {
      "type": "string",
      "enum": [
        "Jauharabad",
        "Qaidabad"
      ],
      "description": "Sub Division"
    },
    "section": {
      "type": "string",
      "description": "Zilladar Section"
    },
    "mouza": {
      "type": "string",
      "description": "Mouza / village name"
    },
    "officer_role": {
      "type": "string",
      "enum": [
        "zilladar",
        "patwari"
      ],
      "description": "Role of assigned officer"
    },
    "officer_name": {
      "type": "string",
      "description": "Name of the assigned officer"
    },
    "officer_user_id": {
      "type": "string",
      "description": "User id of assigned officer (if registered)"
    },
    "title": {
      "type": "string",
      "description": "Task / application subject"
    },
    "description": {
      "type": "string",
      "description": "Task details or document reference"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "review",
        "forwarded",
        "approved",
        "completed",
        "rejected"
      ],
      "default": "pending"
    },
    "assigned_by_name": {
      "type": "string",
      "description": "Deputy Collector who assigned"
    },
    "file_url": {
      "type": "string",
      "description": "Attached document/file URL"
    },
    "photo_url": {
      "type": "string",
      "description": "Camera photo URL"
    },
    "forwarded_to": {
      "type": "string",
      "description": "officer_role this was forwarded to (e.g. patwari)"
    },
    "forwarded_by": {
      "type": "string",
      "description": "Name of officer who forwarded"
    },
    "remarks": {
      "type": "string",
      "description": "Officer remarks on update/completion"
    },
    "history_json": {
      "type": "string",
      "description": "JSON array of status change events"
    }
  },
  "required": [
    "division",
    "subdivision",
    "section",
    "officer_role",
    "title"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}