{
  "name": "LandMap",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Map title"
    },
    "village": {
      "type": "string"
    },
    "district": {
      "type": "string",
      "description": "Division (\u0688\u0648\u06cc\u0698\u0646)"
    },
    "tehsil": {
      "type": "string",
      "description": "Sub Division (\u0633\u0628 \u0688\u0648\u06cc\u0698\u0646)"
    },
    "section": {
      "type": "string",
      "description": "Section (\u0633\u06cc\u06a9\u0634\u0646)"
    },
    "zilladar_section": {
      "type": "string",
      "description": "Zilladar Section (\u0636\u0644\u0639\u062f\u0627\u0631\u06cc \u0633\u06cc\u06a9\u0634\u0646)"
    },
    "rajbah": {
      "type": "string",
      "description": "Rajbah / Canal Minor name (\u0631\u0627\u062c\u0628\u0627\u06c1)"
    },
    "moga_number": {
      "type": "string",
      "description": "Moga Number (\u0645\u0648\u06af\u06c1 \u0646\u0645\u0628\u0631\u06cc)"
    },
    "mogha_side": {
      "type": "string",
      "enum": [
        "L",
        "R"
      ],
      "description": "Mogha Side L/R"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_progress",
        "review",
        "approved",
        "published"
      ],
      "default": "draft"
    },
    "total_parcels": {
      "type": "number",
      "default": 0
    },
    "drawing_data": {
      "type": "string",
      "description": "JSON string of all canvas objects"
    },
    "viewport": {
      "type": "string",
      "description": "JSON string of zoom/pan state"
    },
    "editor_settings": {
      "type": "string",
      "description": "JSON string of editor settings (layers, colors, snap, killa, grid flags)"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "geo_placement_lat": {
      "type": "number",
      "description": "Saved GeoMap overlay placement latitude (upper-left corner anchor)"
    },
    "geo_placement_lng": {
      "type": "number",
      "description": "Saved GeoMap overlay placement longitude (upper-left corner anchor)"
    },
    "geo_rotation": {
      "type": "number",
      "default": 0,
      "description": "Saved GeoMap overlay rotation in degrees"
    },
    "geo_moga_filter": {
      "type": "string",
      "description": "Saved GeoMap moga filter for overlay display"
    },
    "is_template": {
      "type": "boolean",
      "default": false,
      "description": "True for sample/demo maps shown to all users as motivation"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.is_template": true
        },
        {
          "data.status": {
            "$in": [
              "approved",
              "published"
            ]
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}