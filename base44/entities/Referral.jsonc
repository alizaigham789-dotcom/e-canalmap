{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referrer_user_id": {
      "type": "string",
      "description": "User id of the inviter"
    },
    "referred_user_id": {
      "type": "string",
      "description": "User id of the invited user"
    },
    "referred_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "qualified"
      ],
      "default": "pending",
      "description": "pending = invited, qualified = invited user paid"
    },
    "plan_code": {
      "type": "string",
      "enum": [
        "2m",
        "6m",
        "y"
      ],
      "description": "Plan the referred user paid for (set when qualified)"
    }
  },
  "required": [
    "referrer_user_id",
    "referred_user_id"
  ],
  "rls": {
    "create": {
      "data.referred_user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.referrer_user_id": "{{user.id}}"
        },
        {
          "data.referred_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.referred_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}