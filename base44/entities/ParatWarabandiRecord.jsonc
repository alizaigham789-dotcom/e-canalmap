{
  "name": "ParatWarabandiRecord",
  "type": "object",
  "properties": {
    "mogha_number": {
      "type": "string",
      "description": "\u0645\u0648\u06af\u06c1 \u0646\u0645\u0628\u0631\u06cc"
    },
    "mogha_side": {
      "type": "string",
      "enum": [
        "L",
        "R",
        ""
      ]
    },
    "mouza": {
      "type": "string"
    },
    "doc_type": {
      "type": "string"
    },
    "data_json": {
