{
  "name": "ParatWarabandiRecord",
  "type": "object",
  "properties": {
    "mogha_number": {
      "type": "string",
      "description": "\u0645\u0648\u06af\u06c1 \u0646\u0645\u0628\u0631\u06cc"
    },
    "mogha_side": {
      "type": "string",
      "enum": [
        "L",
        "R",
        ""
      ],
      "description": "Mogha Side L/R"
    },
    "mouza": {
      "type": "string"
    },
    "doc_type": {
      "type": "string"
    },
    "data_json": {
      "type": "string",
      "description": "JSON of full parat form state (header, rows, notes, cca, settings)"
    },
    "description": {
      "type": "string",
      "description": "Optional description / notes for this record (up to 1000 characters)",
      "maxLength": 1000
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "completed"
      ],
      "default": "draft"
    }
  },
  "required": [
    "mogha_number"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}