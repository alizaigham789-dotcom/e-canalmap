# Choose exactly one backend. Hostinger deployment uses Base44 through
# public/.htaccess; use "supabase" only after applying supabase/schema.sql.
VITE_APP_BACKEND=base44

# ============================================================
# BASE44 (Hostinger / current backend)
# ============================================================
# Find this in your Base44 editor URL (e.g. https://app.base44.com/apps/YOUR_APP_ID/edit)
VITE_BASE44_APP_ID=6a43d51df305887291122b25

# Do not put a private Base44 API key in a Vite environment variable.
# Vite exposes VITE_* values to every browser user. The Hostinger proxy
# does not require this key for the published app API.
# VITE_BASE44_API_KEY=

# Required for Base44 auth and app metadata. Keep this aligned with the
# published hostname used by public/.htaccess for the Hostinger proxy.
VITE_BASE44_APP_BASE_URL=https://e-canal-map-91122b25.base44.app

# Optional — Pin a specific functions version
# VITE_BASE44_FUNCTIONS_VERSION=

# ============================================================
# SUPABASE (new self-hosted backend)
# ============================================================
# Create a project at supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://ikxbvgmalusemygfqeiq.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_IjDU__SpMgLaaxCxQtkzTw_hSnW-B1x