# ============================================================
# BASE44 (current backend — keep until migration is complete)
# ============================================================
# Find this in your Base44 editor URL (e.g. https://app.base44.com/apps/YOUR_APP_ID/edit)
VITE_BASE44_APP_ID=your_app_id_here

# Optional — Override the Base44 API base URL if needed
# VITE_BASE44_APP_BASE_URL=

# Optional — Pin a specific functions version
# VITE_BASE44_FUNCTIONS_VERSION=

# ============================================================
# SUPABASE (new self-hosted backend)
# ============================================================
# Create a project at supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here